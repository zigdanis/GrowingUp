{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "sweetpad",
            "action": "launch",
            "label": "sweetpad: launch",
            "isBackground": true,
            "problemMatcher": {
                "owner": "sweetpad",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "."
                }
            }
        },
        {
            "type": "sweetpad",
            "action": "build",
            "problemMatcher": [],
            "label": "sweetpad: build"
        }
    ]
}
