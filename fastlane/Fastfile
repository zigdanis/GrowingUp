default_platform :ios
require 'securerandom'
require_relative 'testflight_release'

platform :ios do
  desc 'Check Apple account, tester access and app/widget signing without uploading'
  lane :release_preflight do
    run_release(upload: false)
  end

  desc 'Archive, upload or resume the exact recorded GrowingUp TestFlight release'
  lane :app_store do
    run_release(upload: true)
  end

  desc 'Read Apple processing/distribution status without archiving or uploading'
  lane :release_status do
    run_release(upload: true, status_only: true)
  end

  def run_release(upload:, status_only: false)
    UI.user_error!('Use the manually dispatched TestFlight workflow') unless ENV['GITHUB_ACTIONS'] == 'true'
    source = ENV.fetch('RELEASE_SOURCE_DIR')
    project = File.join(source, 'GrowingUp.xcodeproj')
    ['GrowingUp/Supporting Files/Info.plist', 'Widget/Info.plist'].each do |path|
      info = Xcodeproj::Plist.read_from_path(File.join(source, path))
      UI.user_error!('Source app/widget must use CURRENT_PROJECT_VERSION') unless info['CFBundleVersion'] == '$(CURRENT_PROJECT_VERSION)'
    end
    info = Xcodeproj::Plist.read_from_path(File.join(source, 'GrowingUp/Supporting Files/Info.plist'))
    UI.user_error!('Encryption declaration needs review before release') unless info['ITSAppUsesNonExemptEncryption'] == false
    target = Xcodeproj::Project.open(project).targets.find { |t| t.name == 'GrowingUp' }
    settings = target.build_configurations.find { |c| c.name == 'Release' }.build_settings
    ENV['PROJECT_VERSION'] = settings.fetch('MARKETING_VERSION')
    ENV['PROJECT_BUILD'] = settings.fetch('CURRENT_PROJECT_VERSION')
    release = TestflightRelease.new
    begin
      api_key = app_store_connect_api_key(key_id: ENV.fetch('ASC_KEY_ID'), issuer_id: ENV.fetch('ASC_ISSUER_ID'),
                                          key_filepath: ENV.fetch('ASC_KEY_PATH'), duration: 1200)
    ensure
      # Clear even when token creation fails, before Fastlane prints lane context.
      lane_context.delete(SharedValues::APP_STORE_CONNECT_API_KEY)
    end
    release.preflight!(configure: !status_only)
    release.prepare! if upload
    return release.status! if status_only
    if !upload || release.upload_needed?
      keychain = File.join(ENV.fetch('RELEASE_TEMP'), 'signing.keychain')
      keychain_password = SecureRandom.hex(32)
      begin
        create_keychain(path: keychain, password: keychain_password, default_keychain: false, unlock: true, timeout: 3600)
        match(type: 'appstore', readonly: false, api_key: api_key,
              app_identifier: [TestflightRelease::APP_ID, TestflightRelease::WIDGET_ID],
              team_id: ENV.fetch('APPLE_TEAM_ID'), keychain_name: keychain, keychain_password: keychain_password,
              generate_apple_certs: true, renew_expired_certs: true,
              git_private_key: ENV.fetch('MATCH_GIT_PRIVATE_KEY_PATH'),
              git_full_name: 'GrowingUp Release', git_user_email: 'release@users.noreply.github.com')
        if upload
          configure_release_signing(project, lane_context.fetch(SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING))
          directory = ENV.fetch('RELEASE_TEMP')
          archive = File.join(directory, 'GrowingUp.xcarchive')
          gym(project: project, scheme: 'GrowingUp', configuration: 'Release',
              export_method: 'app-store', output_directory: directory, output_name: 'GrowingUp.ipa',
              archive_path: archive, derived_data_path: File.join(directory, 'DerivedData'),
              buildlog_path: File.join(directory, 'logs'),
              xcargs: "MARKETING_VERSION=#{release.record.fetch('version')} CURRENT_PROJECT_VERSION=#{release.record.fetch('build_number')}",
              export_options: { signingStyle: 'manual', teamID: ENV.fetch('APPLE_TEAM_ID'),
                                provisioningProfiles: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] })
          verify_release_archive(archive, release.record)
          release.begin_upload!
          pilot(api_key: api_key, app_identifier: TestflightRelease::APP_ID, apple_id: release.app['id'],
                ipa: File.join(directory, 'GrowingUp.ipa'), skip_submission: true, skip_waiting_for_build_processing: true)
          release.uploaded!
        end
      ensure
        actual_keychain = File.exist?("#{keychain}-db") ? "#{keychain}-db" : keychain
        delete_keychain(keychain_path: actual_keychain) if File.exist?(actual_keychain)
      end
    end
    if upload
      release.wait_for_processing!
      pilot(**release.pilot_options, api_key: api_key)
      release.verify_distribution!
      UI.success("TestFlight #{release.record['version']} (#{release.record['build_number']}): #{release.record['phase']}. Await Danis's device confirmation.")
    end
  ensure
    release&.write_report
  end

  def configure_release_signing(project, profiles)
    { 'GrowingUp' => TestflightRelease::APP_ID, 'Widget' => TestflightRelease::WIDGET_ID }.each do |target, identifier|
      update_code_signing_settings(path: project, use_automatic_signing: false,
                                  targets: [target], build_configurations: ['Release'],
                                  profile_name: profiles.fetch(identifier))
    end
  end

  def verify_release_archive(archive, record)
    app = File.join(archive, 'Products/Applications/GrowingUp.app')
    paths = [File.join(app, 'Info.plist')] + Dir[File.join(app, 'PlugIns/*.appex/Info.plist')]
    UI.user_error!('Archive must contain GrowingUp and its widget') unless paths.length == 2
    expected_ids = [TestflightRelease::APP_ID, TestflightRelease::WIDGET_ID]
    paths.each do |path|
      info = Xcodeproj::Plist.read_from_path(path)
      UI.user_error!('Unexpected archived bundle identifier') unless expected_ids.delete(info['CFBundleIdentifier'])
      unless info['CFBundleShortVersionString'] == record.fetch('version') && info['CFBundleVersion'] == record.fetch('build_number')
        UI.user_error!('Archived app/widget version or build number differs from release receipt')
      end
    end
  end
end
