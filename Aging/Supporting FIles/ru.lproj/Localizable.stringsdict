			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>li</string>
			<key>one</key>
			<string>%li секунда</string>
			<key>many</key>
			<string>%li секунд</string>
			<key>other</key>
			<string>%li секунды</string>
		</dict>
	</dict>
